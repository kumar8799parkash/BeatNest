# ignore the environment variables:
backend/.env

#ignore node_modules                ***  node_modules is a folder, so we will use a slash(/) in last. Writing slash(/) means we are telling github that node_modules is a folder(slash(/) => folder/directory  and  NO-slash => file) and ignore this folder and everything inside this folder(node_modules)
backend/node_modules/

#ignore my own backend notes
backend/backendNotes.txt

#ignore my own frontend notes
docs/frontendNotes.txt